{
  "uid": "testnet",
  "title": "DCC Testnet",
  "tags": ["dcc", "testnet"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Block Height",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "none",
          "noValue": "—"
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dcc_block_height{node=\"main-node\"}",
          "legendFormat": "height"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Chain Age",
      "description": "Seconds since last block. Alert if > 60s.",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          },
          "unit": "s",
          "noValue": "—"
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dcc_blockchain_height_age_seconds{node=\"main-node\"}",
          "legendFormat": "age"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Block Height Over Time",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "none"
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dcc_block_height",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Chain Staleness",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 60 }] }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dcc_blockchain_height_age_seconds",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "T0 Lag (Deterministic Finality)",
      "description": "Blocks behind the tip not yet finalized (feature-25 Deterministic Finality; authoritative T0). See the separate T2 Lag panel below for the observational HotStuff commit lag (dcc_hotstuff_lag).",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 100 }] }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dcc_finality_lag",
          "legendFormat": "lag {{node}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Finalized Height",
      "description": "feature-25 Deterministic Finality finalized block height (GET /blocks/height/finalized).",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "none"
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dcc_finalized_height",
          "legendFormat": "finalized {{node}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Peers Connected",
      "gridPos": { "x": 0, "y": 36, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          },
          "unit": "none",
          "noValue": "—"
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dcc_peers_connected{node=\"main-node\"}",
          "legendFormat": "peers"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Peers Connected Over Time",
      "gridPos": { "x": 6, "y": 36, "w": 6, "h": 4 },
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "none"
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dcc_peers_connected",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "T2 Lag (HotStuff, observational)",
      "description": "Blocks the observational T2 HotStuff commit is behind the chain tip (dcc_hotstuff_lag). Only present when hotstuff.enabled and it has committed >=1 block; feature-25 Deterministic Finality (T0 Lag panel above) remains authoritative. See docs/hotstuff-step5-findings-and-rework.md — T2 is not yet a finality guarantee.",
      "gridPos": { "x": 0, "y": 44, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 50 }] },
          "noValue": "no HotStuff commit yet"
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dcc_hotstuff_lag",
          "legendFormat": "T2 lag {{node}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Generators Active",
      "description": "Count of gen-* nodes that produced a block in the last 60s (dcc_blockchain_height_age_seconds < 60), federated in from the LKE in-cluster metrics-exporter (Task 13 cross-site federation — clusters/testnet/monitoring/metrics-exporter.yaml). Expect 2 (gen-0, gen-1) on testnet.",
      "gridPos": { "x": 0, "y": 52, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          },
          "unit": "none",
          "noValue": "—"
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(dcc_blockchain_height_age_seconds{node=~\"gen-.*\"} < 60) OR on() vector(0)",
          "legendFormat": "generators active"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Per-Node Block Height (gen-0 / gen-1 / val-0)",
      "description": "Federated from the LKE in-cluster metrics-exporter (:9200 — Task 13). Complements the 'Block Height Over Time' panel above, which shows dcc_block_height for whichever node is behind the public main-node endpoint; this panel shows all three LKE-hosted nodes individually.",
      "gridPos": { "x": 6, "y": 52, "w": 6, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "none"
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dcc_block_height{node=~\"gen-.*|val-.*\"}",
          "legendFormat": "{{node}}"
        }
      ]
    }
  ]
}
