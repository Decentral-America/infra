# Single source of truth for the node-scala image running on the VPS
# (Newark, testnet-node.decentralchain.io main node).
#
# Read by deploy-node-config.yml, restart-host-network.yml, and
# update-node-image.yml -- previously each workflow hardcoded this digest
# independently, and keeping 3 copies in sync by comment discipline alone
# caused a real incident (PR#88 "tag-drift bomb", recurred 2026-08-03): a
# later run of one workflow silently reverted the VPS to a stale image
# because its own copy hadn't been bumped.
#
# To promote a new build: update NODE_SCALA_IMAGE below in one commit, then
# run whichever of the 3 workflows you actually need. No file to duplicate.
#
# Must equal the digest pinned 3x in clusters/testnet/apps/nodes.yaml (rule D6:
# every node on a chain runs the same binary). scripts/check-digest-parity.sh
# enforces this in CI.
NODE_SCALA_IMAGE=ghcr.io/decentral-america/node-scala@sha256:29259c7e802275c2945b81cdd92769bfb76edc95312c19fe79a8103bd81267bd # pinned by pin-node-image-digest.yml from testnet-latest
